# Picco system-screen icons (T_Wifi, T_Fonts, T_HyphenationPacks), traced from the boards'
# inline SVGs in piccoSystemSvg/ (stroke 1.75). Lucide's wifi, lock and download differ from
# the boards in geometry, so none comes from Lucide. Regenerate with:
# uv run --with pillow python3 scripts/generate_icons.py --library lucide \
#   --manifest src/components/icons/piccoSystemIcons.manifest \
#   --extra-svgdir src/components/icons/piccoSystemSvg --sizes 22,26 --stroke-width 1.75 \
#   --out src/components/icons/piccoSystemIcons.h
# then clang-format -i the output.
picco_wifi_3 = picco-wifi-3
picco_wifi_2 = picco-wifi-2
picco_wifi_1 = picco-wifi-1
picco_lock = picco-lock
picco_download = picco-download
